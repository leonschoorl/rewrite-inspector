packages:
  .

-- Build documentation for all dependencies so we can upload docs to hackage
-- with proper links
package *
  documentation: True

-- The fail package is empty for GHC 8+, and haddock errors out on it
package fail
  documentation: False


index-state: 2026-06-15T22:35:32Z

allow-newer:
  brick:base,
  brick:deepseq,
  vty:deepseq,
